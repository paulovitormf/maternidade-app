# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS (MYSQL)
# ==========================================
MYSQL_PORT=3306
MYSQL_DATABASE=maternidade
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=maternidade_app
MYSQL_PASSWORD=change_me_app_password

# ==========================================
# CONFIGURAÇÕES DAS APLICAÇÕES
# ==========================================
BACKEND_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8080/api
DB_HOST=localhost
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# ==========================================
# VERIFICAÇÃO DE E-MAIL (BREVO)
# ==========================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Maternidade
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_HASH_SECRET=change_me_to_a_different_random_secret_at_least_32_characters