echo "Executando testes do backend..."
mvn -f backend/pom.xml test

if [ $? -ne 0 ]; then
  echo "ERRO: Os testes do backend falharam. Commit cancelado."
  exit 1
fi

echo "Executando testes do frontend..."
(cd frontend && npm test)

if [ $? -ne 0 ]; then
  echo "ERRO: Os testes do frontend falharam. Commit cancelado."
  exit 1
fi

echo "Todos os testes passaram!"